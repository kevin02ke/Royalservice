# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL connection string (ep-little-hall-b5o6vcsm)
# Configure this in the AI Studio Settings -> Secrets panel:
DATABASE_URL="postgresql://neondb_owner:npg_TXm6UtSlW7Ae@ep-little-hall-b5o6vcsm-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# PAYHERO API HTTP BASIC AUTHENTICATION
# Per PayHero Official Documentation (Dashboard -> API Keys):
# Generate API Key to receive your API Username & API Password:
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=

# (Alternative) Direct base64 Basic Auth token if pre-generated:
PAYHERO_AUTH_TOKEN=

# (Fallback) Single API Key string or Username:Password:
PAYHERO_API_KEY=

# PAYHERO_CHANNEL_ID: Your PayHero registered Paybill or Till channel ID (from Payment Channels menu)
PAYHERO_CHANNEL_ID=

# PAYHERO_PROVIDER: Default 'm-pesa'
PAYHERO_PROVIDER="m-pesa"

# PAYHERO_CALLBACK_URL: (Optional) Automatically dynamic per request. Provide only to enforce a static custom URL.
PAYHERO_CALLBACK_URL=
